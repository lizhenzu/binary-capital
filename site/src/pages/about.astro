---
import Base from '../layouts/Base.astro';
const gurus = [
  ['워렌 버핏', '꾸준히 높은 ROE, 이해할 수 있는 사업, 적정 가격'],
  ['피터 린치', '종목을 6가지 유형으로 나눠 유형별로 다르게 판단'],
  ['벤저민 그레이엄', 'PBR 1배 미만 등 숫자로 거르는 안전마진'],
  ['필립 피셔', '성장성과 경영진의 질을 따지는 정성 평가'],
];
const rules = [
  '모든 수치에 날짜와 출처',
  '확인 못 한 것은 "미확인"',
  '사실과 의견을 나눠 표기',
  '"지금 사라" 대신 "이 조건이면 검토"',
  '종목마다 반대 의견 필수',
  '소문·찌라시는 근거로 쓰지 않음',
];
---
<Base title="회사 소개·원칙" section="about">
  <main class="wrap page" style="gap:52px">
    <section style="display:flex;flex-direction:column;gap:16px;max-width:820px">
      <h1 class="h1" style="font-size:clamp(28px,3.6vw,40px);line-height:1.35">투자 고수의 원칙을 국내 시장에서 배우는 가상 투자회사</h1>
      <p class="lead">바이너리 자산운용은 코스피·코스닥만 다루는 학습용 가상 회사입니다. 워렌 버핏, 피터 린치, 벤저민 그레이엄, 필립 피셔의 원칙을 국내 종목에 적용해 보고, 매주 그 과정과 결과를 기록합니다. 매매 결정과 실행은 대표가 직접 하며 자동매매는 없습니다.</p>
    </section>

    <section class="section" aria-labelledby="flow">
      <h2 id="flow" class="h2">리포트는 이렇게 만들어집니다</h2>
      <div class="grid" style="--min:340px;gap:16px">
        <div class="card card-lg" style="display:flex;flex-direction:column;gap:14px">
          <span class="badge badge-sat">토요일 · 지난주 복기</span>
          <div class="flow"><span class="s">시장분석팀</span><span aria-hidden="true">→</span><span class="s">실패분석팀</span><span aria-hidden="true">→</span><span class="s">고수전략팀</span><span aria-hidden="true">→</span><span class="s end">리서치 총괄 조립</span></div>
          <p style="margin:0;font-size:15px;color:var(--ink-2)">지난주 시장을 정리하고, 회사의 판단이 맞았는지 채점하고, 실수 패턴을 갱신합니다.</p>
        </div>
        <div class="card card-lg" style="display:flex;flex-direction:column;gap:14px">
          <span class="badge badge-sun">일요일 · 다음 주 준비</span>
          <div class="flow"><span class="s">시장분석</span><span aria-hidden="true">→</span><span class="s">고수전략</span><span aria-hidden="true">→</span><span class="s">예측분석</span><span aria-hidden="true">→</span><span class="s">트레이딩</span><span aria-hidden="true">→</span><span class="s end">리스크 승인</span></div>
          <p style="margin:0;font-size:15px;color:var(--ink-2)">리스크관리팀이 승인한 제안만 리포트에 실립니다. 앞 팀의 산출물이 없으면 다음 팀은 일하지 않습니다.</p>
        </div>
      </div>
    </section>

    <section id="principles" class="section" aria-labelledby="gurus">
      <h2 id="gurus" class="h2">따라 배우는 네 명의 고수</h2>
      <div class="grid" style="--min:240px">
        {gurus.map(([n, d]) => <div class="card"><strong style="font-size:17px">{n}</strong><p style="margin:8px 0 0;font-size:15px;color:var(--ink-2)">{d}</p></div>)}
      </div>
      <div class="callout callout-info">모든 종목은 <strong>체크리스트 6항</strong>과 <strong>25점 종합 평가표</strong>로 채점합니다. 20점 이상만 관심 종목에 오르고, 그 아래는 관찰 목록으로 둡니다.</div>
    </section>

    <section class="section" aria-labelledby="rules">
      <h2 id="rules" class="h2">리포트 작성 원칙</h2>
      <div class="grid" style="--min:260px">
        {rules.map((t, i) => <div class="card"><span class="num" style="font-size:13px;color:var(--accent);font-weight:600">{String(i + 1).padStart(2, '0')}</span><div style="font-weight:600;margin-top:6px">{t}</div></div>)}
      </div>
    </section>

    <section class="section" aria-labelledby="faq" style="max-width:860px;gap:10px">
      <h2 id="faq" class="h2" style="margin-bottom:6px">자주 묻는 질문</h2>
      <details class="faq"><summary>리포트대로 사면 수익이 나나요?</summary><p>보장하지 않습니다. 리포트는 판단 과정을 배우기 위한 기록이며, 맞은 판단도 운이 섞였는지 따로 채점합니다.</p></details>
      <details class="faq"><summary>리포트는 누가 쓰나요?</summary><p>AI 리서치팀(6개 팀)이 공개 자료로 초안을 쓰고, 리서치 총괄이 하나로 묶습니다. 매매 결정은 대표가 직접 합니다.</p></details>
      <details class="faq"><summary>리포트는 언제 올라오나요?</summary><p>매주 토요일(지난주 복기)과 일요일(다음 주 준비)에 올라옵니다.</p></details>
    </section>

    <section id="disclaimer" class="card card-lg" aria-labelledby="disc" style="border:2px solid var(--ink);max-width:860px;display:flex;flex-direction:column;gap:12px">
      <h2 id="disc" class="h3" style="font-size:22px">면책 고지</h2>
      <p style="margin:0;font-size:16px;line-height:1.8">이 사이트의 모든 리포트는 학습용 분석 자료이며 투자 결과를 보장하지 않습니다. 특정 종목의 매수·매도를 권유하지 않으며, 투자 판단과 그 결과에 대한 책임은 투자자 본인에게 있습니다. 바이너리 자산운용은 금융당국에 등록된 금융회사가 아닌 개인의 학습용 가상 회사입니다.</p>
    </section>
  </main>
</Base>
